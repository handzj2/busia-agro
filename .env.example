# Formspree form ID for the contact form (https://formspree.io)
# Create a form, then paste the ID here (e.g. xyzabcde)
NEXT_PUBLIC_FORMSPREE_ID=YOUR_FORM_ID

# Production site URL for metadata, OG, canonical, robots, sitemap
# Set this in Vercel → Environment Variables (Production) to the canonical domain
NEXT_PUBLIC_SITE_URL=https://www.busiafamerssuupplies.com

# ─────────────────────────────────────────────────────────────
# MAINTENANCE MODE (added 2026-09-19)
# ─────────────────────────────────────────────────────────────
# SITE_STATUS=ON   → normal website (default if this line is missing)
# SITE_STATUS=OFF  → entire site shows the offline / maintenance page
#
# On Vercel: Project → Settings → Environment Variables → add SITE_STATUS
# Then Redeploy production.
# See DEPLOY.md for full steps. Nothing is deleted when you turn it OFF.
# ─────────────────────────────────────────────────────────────
SITE_STATUS=ON
