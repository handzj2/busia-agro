# Formspree form ID for the contact form (https://formspree.io)
# Create a form, then paste the ID here (e.g. xyzabcde)
NEXT_PUBLIC_FORMSPREE_ID=YOUR_FORM_ID

# Optional: site URL for metadata / OG
# NEXT_PUBLIC_SITE_URL=https://busia-farmers-supplies.vercel.app

# ─── Site suspension switch ───────────────────────────────
# Set to OFF to put the entire production site into maintenance mode.
# Set to ON (or leave unset) for the normal website.
# Toggle in Vercel → Project → Settings → Environment Variables, then redeploy.
SITE_STATUS=ON
